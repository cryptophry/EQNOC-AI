# Copy to .env.local and fill in. In production, set these in Vercel → Settings → Environment Variables.

# OpenRouter API key (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: model slug used for all AI calls (clients cannot override it)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Shared login password. The login screen verifies this server-side and issues a token.
APP_PASSWORD=change-me

# Optional: HMAC secret used to sign auth tokens. Falls back to APP_PASSWORD if unset.
# Set a long random value in production (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Optional: local dev API port (defaults to 8787)
# API_PORT=8787
