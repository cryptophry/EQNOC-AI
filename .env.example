# Copy to .env.local and fill in. In production, set these in Vercel → Settings → Environment Variables.

# OpenRouter API key (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=sk-or-v1-...

# Text model for ordinary chat (clients cannot override it)
OPENROUTER_MODEL=x-ai/grok-4.6

# Optional: cheaper vision model for pasted images and ingestion OCR.
# Leave unset to use the same model as OPENROUTER_MODEL / the grok-4.6 default.
# OPENROUTER_VISION_MODEL=anthropic/claude-haiku-4.5

# Shared login password. The login screen verifies this server-side.
APP_PASSWORD=change-me

# HMAC secret used to sign the HttpOnly session cookie.
# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: Upstash Vector — required for manuals, guides, and reference-image RAG.
# Chat still works without these; those features return 503 until set.
# UPSTASH_VECTOR_REST_URL=https://....upstash.io
# UPSTASH_VECTOR_REST_TOKEN=

# Optional: local dev API port (defaults to 8787)
# API_PORT=8787
